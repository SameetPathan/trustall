# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client id again; this one is the only PayPal value the browser sees
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Id of the webhook registered for <APP_URL>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# Vision and tool-calling model (Anthropic API key and model id)
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trustall

# Public base URL, used in QR codes
APP_URL=http://localhost:3000

# Passcode for the demo stall's owner view (printed in the README for judges)
OWNER_DEMO_PASSCODE=meadowlane
# Signs the owner session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
